# ═══════════════════════════════════════════════════════════════════════════
#  B Ledger — Backend environment
#
#  1. Copy this file:            cp example.env .env
#  2. Fill in every [REQUIRED] key below.
#  3. Env is loaded by Node itself (node --env-file=.env) — there is NO dotenv.
#
#  MUST be set before the server boots:   MONGODB_URI, JWT_SECRET
#  MUST be set before `npm run seed`:     SEED_ADMIN_EMAIL / _PHONE / _PASSWORD
#
#  Generate the secrets:
#    JWT_SECRET :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#    VAPID pair :  npx web-push generate-vapid-keys
#
#  Never commit the real .env — it is gitignored. Use a FRESH JWT_SECRET and a
#  FRESH VAPID pair per environment; never reuse dev secrets in production.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=5000
APP_NAME=B Ledger
# [REQUIRED in prod behind a proxy] Number of proxy hops in front of Node, so
# rate limiting reads the real client IP (not the proxy) and Express 5's
# express-rate-limit stops throwing ERR_ERL_UNEXPECTED_X_FORWARDED_FOR.
#   Cloudflare → nginx → node = 2   |   nginx only = 1   |   local dev (no proxy) = 0
TRUST_PROXY_HOPS=0
# [optional] pino level: trace|debug|info|warn|error|fatal|silent.
# Defaults: info in production, debug in dev, silent under test.
LOG_LEVEL=

# ── Database ──────────────────────────────────────────────────────────────
# [REQUIRED] Dev: the value below. Production (Mongo with auth on the VPS):
#   mongodb://USER:PASS@127.0.0.1:27017/bledger?authSource=bledger
MONGODB_URI=mongodb://localhost:27017/b_ledger

# ── Auth ──────────────────────────────────────────────────────────────────
# [REQUIRED] Signs the access token. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
# [optional] Short access-token lifetime; the client refreshes it from the cookie.
JWT_ACCESS_EXPIRE=15m
# [optional] Refresh token (httpOnly cookie) lifetime, in days.
REFRESH_TOKEN_EXPIRE_DAYS=30
# [optional] Refresh-cookie SameSite. 'lax' for a same-origin deploy (app + API on
# one domain); 'none' (HTTPS only) when the frontend is on a different host.
COOKIE_SAMESITE=lax
# [optional] Secure is auto-on in production. Uncomment to force it behind a TLS proxy.
# COOKIE_SECURE=true

# ── URLs / CORS ───────────────────────────────────────────────────────────
# [REQUIRED in prod] Public URL of the web app. Builds invite / reset links AND
# counts as an allowed origin.
FRONTEND_URL=http://localhost:3000
# [REQUIRED for cross-origin prod] Extra allowed origins, comma-separated. Governs
# BOTH REST CORS and the Socket.io handshake (utils/cors.js is shared).
# localhost:3000 is always allowed. Same-origin deploy → leave blank; split-host
# deploy → put the frontend's URL here or its API calls + websocket are rejected.
ALLOWED_ORIGINS=
# [optional] Public URL of this API, shown in the Swagger docs.
SERVER_URI=http://localhost:5000

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# [optional in dev / REQUIRED in prod] Sends invite + password-reset mail.
# Dev — Mailpit (https://mailpit.axllent.org): SMTP 1025, inbox :8025, no auth
#   (leave USER/PASS blank).
# Prod — Brevo: HOST smtp-relay.brevo.com, PORT 587, USER your Brevo SMTP login,
#   PASS a Brevo SMTP key. Verify FROM_EMAIL's domain in Brevo (add its DKIM/SPF
#   DNS records at your registrar) or mail lands in spam.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_NAME=B Ledger
FROM_EMAIL=no-reply@b-ledger.pk

# ── Web Push (PWA notifications) ──────────────────────────────────────────
# [optional — leave blank to disable push] Generate a fresh pair per environment:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY MUST equal VITE_VAPID_PUBLIC_KEY in the frontend, or the
# browser's subscription is rejected on send. NEVER commit these — a leaked
# private key is burned the moment it hits a repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com

# ── Seeder (npm run seed — creates the first admin) ───────────────────────
# [REQUIRED to seed] There is deliberately no default admin password.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@b-ledger.pk
SEED_ADMIN_PHONE=+923001234567
SEED_ADMIN_PASSWORD=
