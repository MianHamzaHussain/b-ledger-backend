# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=B Ledger

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/b_ledger

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRE=7d

# ── URLs / CORS ───────────────────────────────────────────────────────────
# FRONTEND_URL builds invite and password-reset links.
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma-separated. localhost:3000 is always allowed.
ALLOWED_ORIGINS=
# Public URL of this API, shown in Swagger.
SERVER_URI=http://localhost:5000

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# Local development uses Mailpit (https://mailpit.axllent.org): SMTP on 1025,
# no auth, and a web inbox at http://localhost:8025. Leave USER/PASS blank and
# the mailer skips authentication. For a real provider, fill all four in and
# use port 465 (implicit TLS) or 587 (STARTTLS).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_NAME=B Ledger
FROM_EMAIL=no-reply@b-ledger.pk

# ── Web Push (PWA notifications) ──────────────────────────────────────────
# Generate a fresh pair with: npx web-push generate-vapid-keys
# Use a DIFFERENT pair per environment — a fresh one for local, and a new one
# for production (never reuse local's). NEVER commit these; a leaked private key
# lets anyone push to your users and is burned the moment it hits a repo.
# VAPID_PUBLIC_KEY must equal VITE_VAPID_PUBLIC_KEY in the frontend env, or the
# browser's subscription will be rejected on send. Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com

# ── Seeder (npm run seed) ─────────────────────────────────────────────────
# Required. There is deliberately no default admin password.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@b-ledger.pk
SEED_ADMIN_PHONE=+923001234567
SEED_ADMIN_PASSWORD=
