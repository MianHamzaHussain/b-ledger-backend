# Copy to /etc/bledger-backup/backup.env (chmod 600, owned by root).

# PUBLIC key from `age-keygen` (starts with age1…). The private key must NOT be on this server.
AGE_RECIPIENT=age1replace_me

# rclone remote + bucket, as configured with `rclone config`.
RCLONE_REMOTE=b2:bledger-backups

# Optional: ping URL from healthchecks.io (period 1 hour, grace 30 minutes).
HEALTHCHECK_URL=

# Defaults, change only if needed.
LOCAL_DIR=/var/backups/bledger
LOCAL_KEEP_HOURS=48
ENV_FILE=/var/www/sites/b-ledger-backend/.env
