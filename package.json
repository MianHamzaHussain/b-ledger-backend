{
  "name": "b-ledger-backend",
  "version": "1.0.0",
  "description": "B Ledger REST API — Express + MongoDB",
  "main": "server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node --env-file=.env server.js",
    "seed": "node --env-file=.env seeder.js -i",
    "backfill:cities": "node --env-file=.env scripts/backfillCities.mjs",
    "normalize:phones": "node --env-file=.env scripts/normalizeCustomerPhones.mjs",
    "postex:stages": "node --env-file=.env scripts/postexStages.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.js": [
      "oxlint",
      "prettier --write"
    ]
  },
  "overrides": {
    "sanitize-html": "^2.18.1",
    "glob": "^13.0.6"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-xss-sanitizer": "^2.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^9.9.3",
    "nodemailer": "^10.2.1",
    "pdf-lib": "1.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@scarf/scarf": false
  }
}
